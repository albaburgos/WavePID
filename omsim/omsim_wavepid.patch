+void ROOTHitManager::FillTrack(int eventID, int trackID, int parentID, const std::string& particle,
+                               const std::string& creator, double energyMeV, double wavelengthNm, int detected,
+                               const std::vector<float>& x, const std::vector<float>& y,
+                               const std::vector<float>& z, const std::vector<float>& t)
+{
+    std::lock_guard<std::mutex> lock(m_fillMutex);
+    m_trEvent = eventID; m_trID = trackID; m_trParent = parentID; m_trDetected = detected;
+    m_trParticle = particle.c_str(); m_trCreator = creator.c_str();
+    m_trEnergy = energyMeV; m_trWavelength = wavelengthNm;
+    m_trX = x; m_trY = y; m_trZ = z; m_trT = t;
+    m_trackTree->Fill();
+}
+
 void ROOTHitManager::FillPhotonInfo(const PhotonInfoROOT& info)
 {
+    // Worker threads all write into the same TTree; serialise the copy + Fill.
+    std::lock_guard<std::mutex> lock(m_fillMutex);
     m_photonInfo = info;
     m_tree->Fill();
 }
+
+void ROOTHitManager::FillEvent(int eventID, double energyGeV, const std::string& particle,
+                               const double vertexM[3], const double nuDir[3])
+{
+    std::lock_guard<std::mutex> lock(m_fillMutex);
+    m_evVx = vertexM[0]; m_evVy = vertexM[1]; m_evVz = vertexM[2];
+    m_evNx = nuDir[0]; m_evNy = nuDir[1]; m_evNz = nuDir[2];
+    m_evID = eventID;
+    m_evEnergy = energyGeV;
+    m_evParticle = particle.c_str();
+    m_eventTree->Fill();
+    // Every 10 events write the tree headers and flush the baskets, so that a job killed at its time limit leaves a
+    // file ROOT can recover with the events completed so far (without this the whole part is lost).
+    if (++m_eventsFilled % 10 == 0) {
+        m_tree->AutoSave("SaveSelf,FlushBaskets,Overwrite");
+        m_eventTree->AutoSave("SaveSelf,FlushBaskets,Overwrite");
+        if (m_trackTree && m_trackTree->GetEntries() > 0) m_trackTree->AutoSave("SaveSelf,FlushBaskets,Overwrite");
+    }
+}
