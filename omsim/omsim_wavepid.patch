+/**
+ * @brief Ionisation and multiple scattering for charged hadrons and ions.
+ * Leptons, gammas and optical photons keep the hand-tuned processes above.
+ */
+void OMSimPhysicsList::addHadronEMProcesses()
+{
+    auto it = GetParticleIterator();
+    it->reset();
+    while ((*it)()) {
+        G4ParticleDefinition* particle = it->value();
+        const G4String& name = particle->GetParticleName();
+        if (particle->GetPDGCharge() == 0.0 || particle->IsShortLived()) continue;
+        if (name == "e-" || name == "e+" || name == "mu-" || name == "mu+") continue;
+        G4ProcessManager* pm = particle->GetProcessManager();
+        if (name == "GenericIon" || name == "alpha" || name == "He3" ||
+            name == "deuteron" || name == "triton") {
+            pm->AddProcess(new G4hMultipleScattering(), -1, 1, 1);
+            pm->AddProcess(new G4ionIonisation(), -1, 2, 2);
+            pm->AddProcess(new G4NuclearStopping(), -1, 3, -1);
+        } else {
+            pm->AddProcess(new G4hMultipleScattering(), -1, 1, 1);
+            pm->AddProcess(new G4hIonisation(), -1, 2, 2);
+            if (name == "pi+" || name == "pi-" || name == "kaon+" || name == "kaon-" ||
+                name == "proton" || name == "anti_proton") {
+                pm->AddProcess(new G4hBremsstrahlung(), -1, -1, 3);
+                pm->AddProcess(new G4hPairProduction(), -1, -1, 4);
+            }
+        }
+    }
 }
 
