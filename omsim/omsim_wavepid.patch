@@ -0,0 +1,61 @@
+/**
+ * @file OMSimSteppingAction.cc (WavePID copy)
+ * @brief Stuck-particle guard from the common framework plus an optional
+ * optical-photon kill for photons that can no longer reach the module.
+ */
+#include "OMSimSteppingAction.hh"
+#include "OMSimTrackingAction.hh"
+#include "OMSimCommandArgsTable.hh"
+#include "OMSimLogger.hh"
+#include <G4Step.hh>
+#include <G4Track.hh>
+#include <G4OpticalPhoton.hh>
+#include <G4SystemOfUnits.hh>
+
+namespace {
+G4double killDistance()
+{
+    static G4ThreadLocal G4double s_kill = -1.0;
+    if (s_kill < 0) {
+        s_kill = 0.0;
+        try { s_kill = OMSimCommandArgsTable::getInstance().get<G4double>("photon_kill_distance") * m; } catch (...) {}
+    }
+    return s_kill;
+}
+}
+
+void OMSimSteppingAction::UserSteppingAction(const G4Step* p_step)
+{
+    G4Track* track = p_step->GetTrack();
+
+    // kill particles that are stuck, e.g. looping inside the pressure vessel
+    if (track->GetCurrentStepNumber() > 100000) {
+        log_info("Particle {} with energy {} eV stuck, will be killed!",
+                 track->GetDefinition()->GetParticleName(), 1239.84193 / (track->GetKineticEnergy() / eV));
+        if (track->GetTrackStatus() != fStopAndKill) track->SetTrackStatus(fStopAndKill);
+        return;
+    }
+
+    // Optical photons that are already far from the module (at the origin) and
+    // receding from it cannot be detected any more (ice scattering is strongly
+    // forward-peaked, and a back-scatter at that distance would arrive far outside
+    // any analysis window). Killing them saves most of the tracking time at large
+    // impact parameters.
+    const G4double kill = killDistance();
+    if (kill > 0.0 && track->GetDefinition() == G4OpticalPhoton::Definition()) {
+        const G4ThreeVector& pos = track->GetPosition();
+        if (pos.mag2() > kill * kill && pos.dot(track->GetMomentumDirection()) > 0.0) {
+            track->SetTrackStatus(fStopAndKill);
+        }
+    }
+
+    // --photon_tracks: append the post-step point of the current track (after the kill
+    // checks, so a killed photon keeps its last position)
+    if (OMSimTrackingAction::HasInstance()) {
+        OMSimTrackingAction& ta = OMSimTrackingAction::GetInstance();
+        if (ta.RecordingEnabled()) {
+            const G4StepPoint* post = p_step->GetPostStepPoint();
+            ta.AddStep(post->GetPosition(), post->GetGlobalTime());
+        }
+    }
+}
