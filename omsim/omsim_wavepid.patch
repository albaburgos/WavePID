+void OMSimPrimaryGeneratorAction::loadEventFile(const std::string& path)
+{
+    std::lock_guard<G4Mutex> lock(m_mutex);
+    if (m_eventsLoaded) return;
+    std::ifstream in(path);
+    if (!in) {
+        log_error("Cannot open event file {}", path);
+        throw std::runtime_error("cannot open --event_file " + path);
+    }
+    // format: one particle per line  "<event index> <G4 particle name> <kinetic E [GeV]> <dx> <dy> <dz>"
+    // lines starting with # are comments; event indices must be 0..N-1 (gaps allowed = empty events)
+    std::string line; long maxIndex = -1;
+    std::vector<std::pair<long, FinalStateParticle>> rows;
+    while (std::getline(in, line)) {
+        if (line.empty() || line[0] == '#') continue;
+        std::istringstream ss(line);
+        long idx; FinalStateParticle fp; double dx, dy, dz;
+        if (!(ss >> idx >> fp.name >> fp.kineticEnergyGeV >> dx >> dy >> dz)) continue;
+        fp.direction = G4ThreeVector(dx, dy, dz).unit();
+        rows.emplace_back(idx, fp);
+        maxIndex = std::max(maxIndex, idx);
+    }
+    m_events.assign(maxIndex + 1, {});
+    for (auto& r : rows) m_events[r.first].push_back(r.second);
+    m_eventsLoaded = true;
+    log_info("Event file {}: {} events, {} particles; vertex at ({}, {}, {}) m",
+             path, m_events.size(), rows.size(), m_position.x() / m, m_position.y() / m, m_position.z() / m);
