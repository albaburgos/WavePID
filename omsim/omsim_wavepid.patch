diff --git a/simulations/wavepid/include/OMSimStackingAction.hh b/simulations/wavepid/include/OMSimStackingAction.hh
new file mode 100644
index 00000000..02e083af
--- /dev/null
+++ b/simulations/wavepid/include/OMSimStackingAction.hh
@@ -0,0 +1,26 @@
+#pragma once
+/**
+ * @file OMSimStackingAction.hh
+ * @brief Keeps the Geant4 track stack small: optical photons are tracked first.
+ *
+ * Without this, every Cherenkov photon of a cascade sits on the stack until the
+ * whole sub-shower that created it has been processed, i.e. millions of G4Track
+ * objects (about 1 GB per 30 GeV event per worker thread). Putting all
+ * non-photon secondaries on the "waiting" stack means a charged particle's
+ * photons are tracked (and freed) as soon as that particle is done, while the
+ * parent is never suspended (which is what broke hadronic interactions with
+ * G4Cerenkov::SetTrackSecondariesFirst(true)).
+ */
+#include <G4UserStackingAction.hh>
+#include <G4ClassificationOfNewTrack.hh>
+#include <G4Types.hh>
+
+class OMSimStackingAction : public G4UserStackingAction
+{
+public:
+    OMSimStackingAction();
+    G4ClassificationOfNewTrack ClassifyNewTrack(const G4Track* track) override;
+
+private:
+    G4double m_photonFraction = 1.0;   ///< --photon_fraction: fraction of optical photons kept at creation
+};
