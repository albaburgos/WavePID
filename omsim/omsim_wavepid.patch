+
+G4ClassificationOfNewTrack OMSimStackingAction::ClassifyNewTrack(const G4Track* track)
+{
+    if (track->GetDefinition() == G4OpticalPhoton::Definition()) {
+        // --photon_fraction F < 1: keep a random fraction F of the Cherenkov photons at creation, kill the rest.
+        // OMSimSensitiveDetector divides the detection probability by F, so the detected hits are statistically
+        // identical to the full simulation as long as QE x CE <= F (a two-stage Bernoulli thinning), at 1/F the cost.
+        if (m_photonFraction < 1.0 && G4UniformRand() >= m_photonFraction) return fKill;
+        return fUrgent;
+    }
+    return fWaiting;
+}
