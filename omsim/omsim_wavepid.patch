+void OMSimPrimaryGeneratorAction::generateFromEventFile(G4Event* p_event)
+{
+    if (m_events.empty()) return;
+    const std::size_t idx = static_cast<std::size_t>(p_event->GetEventID()) % m_events.size();
+    if (static_cast<std::size_t>(p_event->GetEventID()) >= m_events.size() && idx == 0)
+        log_warning("More Geant4 events than entries in the event file: wrapping around");
+    // --random_vertex: uniform in a cube around the origin; --random_rotation: uniform rotation of
+    // the whole final state (new x-axis isotropic, then a uniform spin about it), applied to every
+    // particle direction so the event keeps its internal kinematics.
+    G4ThreeVector position = m_position;
+    if (m_randomVertexM > 0)
+        position = G4ThreeVector(2 * G4UniformRand() - 1, 2 * G4UniformRand() - 1, 2 * G4UniformRand() - 1) * m_randomVertexM * m;
+    G4RotationMatrix rot;
+    if (m_randomRotation) {
+        const G4ThreeVector axisX = G4RandomDirection();
+        const G4ThreeVector ex(1, 0, 0);
+        G4ThreeVector pivot = ex.cross(axisX);
+        if (pivot.mag2() > 1e-12) rot.rotate(std::acos(std::max(-1.0, std::min(1.0, ex.dot(axisX)))), pivot.unit());
+        else if (axisX.x() < 0) rot.rotateZ(CLHEP::pi);
+        rot = G4RotationMatrix(axisX, CLHEP::twopi * G4UniformRand()) * rot;
+    }
+    s_lastNuDir = rot * G4ThreeVector(1, 0, 0);
+    auto* vertex = new G4PrimaryVertex(position, 0.0);
+    G4ParticleTable* table = G4ParticleTable::GetParticleTable();
+    int added = 0;
+    for (const auto& fp : m_events[idx]) {
+        G4ParticleDefinition* def = table->FindParticle(fp.name);
+        if (!def) { log_warning("Event {}: unknown particle '{}' skipped (need --hadronic?)", idx, fp.name); continue; }
+        auto* primary = new G4PrimaryParticle(def);
+        primary->SetKineticEnergy(fp.kineticEnergyGeV * GeV);
+        primary->SetMomentumDirection(rot * fp.direction);
+        vertex->SetPrimary(primary);
+        ++added;
+    }
+    if (added == 0) {   // keep the event count in step with the file: shoot a harmless placeholder
+        auto* primary = new G4PrimaryParticle(table->FindParticle("geantino"));
+        primary->SetKineticEnergy(1 * MeV);
+        primary->SetMomentumDirection(G4ThreeVector(1, 0, 0));
+        vertex->SetPrimary(primary);
+    }
+    p_event->AddPrimaryVertex(vertex);
+}
