+    /// Forget all tracks of the previous event. Called at BeginOfEventAction;
+    /// without it the maps grow by every track of every event (GBs per thread).
+    void Reset();
+
+    // --photon_tracks: step-point recording of the track currently being followed.
+    // Geant4 follows one track at a time per thread, so a single buffer is enough; it is
+    // flushed to the PhotonTracks tree in PostUserTrackingAction when the track is a
+    // non-photon, a detected photon, or a photon picked by the sampling fraction.
+    bool RecordingEnabled() const { return m_trackFraction > 0.0; }
+    void AddStep(const G4ThreeVector& pos, G4double time);
+    void MarkDetected() { m_detectedCurrent = true; }
+
 private:
     std::unordered_map<G4int, std::string> m_trackIDToParticleTypeMap;
