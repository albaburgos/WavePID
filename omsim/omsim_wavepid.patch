diff --git a/simulations/wavepid/src/OMSimEventAction.cc b/simulations/wavepid/src/OMSimEventAction.cc
index c0a7ac1a..5716a86a 100644
--- a/simulations/wavepid/src/OMSimEventAction.cc
+++ b/simulations/wavepid/src/OMSimEventAction.cc
@@ -4,11 +4,57 @@
  */
 #include "OMSimEventAction.hh"
 #include <G4RunManager.hh>
+#include <G4Event.hh>
+#include <G4PrimaryVertex.hh>
+#include <G4PrimaryParticle.hh>
+#include <G4ParticleDefinition.hh>
+#include <G4SystemOfUnits.hh>
+#include "OMSimHitManager.hh"
+#include "OMSimTrackingAction.hh"
+#include "OMSimPrimaryGeneratorAction.hh"
+#include "OMSimLogger.hh"
+#include <atomic>
+#include <chrono>
+
+namespace {
+    // progress report every 10 finished events (all worker threads together): count, wall time, seconds per event
+    std::atomic<long> g_eventsDone{0};
+    const auto g_start = std::chrono::steady_clock::now();
+}
 
 void OMSimEventAction::BeginOfEventAction(const G4Event* p_event)
 {
+    // drop the previous event's track bookkeeping (thread-local singleton)
+    if (OMSimTrackingAction::HasInstance()) {
+        OMSimTrackingAction::GetInstance().Reset();
+    }
 }
 
 void OMSimEventAction::EndOfEventAction(const G4Event* p_event)
 {
+    // Store primary energy/type for every event so that zero-hit events are
+    // still accounted for in the per-event bookkeeping (needed for benchmarks).
+    // Energy = sum of kinetic energies of all primaries (several per event with
+    // --event_file); particle = the single primary's name, or "multi(N)".
+    G4double totalKinetic = 0.0; int nPrimaries = 0; std::string name;
+    for (int iv = 0; iv < p_event->GetNumberOfPrimaryVertex(); ++iv) {
+        const G4PrimaryVertex* vertex = p_event->GetPrimaryVertex(iv);
+        for (const G4PrimaryParticle* primary = vertex->GetPrimary(); primary; primary = primary->GetNext()) {
+            totalKinetic += primary->GetKineticEnergy();
+            name = primary->GetParticleDefinition()->GetParticleName();
+            ++nPrimaries;
+        }
+    }
+    if (nPrimaries > 0) {
+        const G4ThreeVector vertexM = p_event->GetPrimaryVertex(0)->GetPosition() / m;
+        OMSimHitManager::getInstance().recordEvent(
+            p_event->GetEventID(), totalKinetic / GeV,
+            nPrimaries == 1 ? name : "multi(" + std::to_string(nPrimaries) + ")",
+            vertexM, OMSimPrimaryGeneratorAction::lastNuDirection());
+    }
+    const long done = ++g_eventsDone;
+    if (done % 10 == 0) {
+        const double secs = std::chrono::duration<double>(std::chrono::steady_clock::now() - g_start).count();
+        log_info("progress: {} events done in {:.0f} s ({:.1f} s/event wall, this run)", done, secs, secs / done);
+    }
 }
